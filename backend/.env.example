# ============================================================
# .env — Backend Configuration
# ============================================================

# Server
HOST=0.0.0.0
PORT=10000
DEBUG=true
CORS_ORIGINS=*

# ML Models
WHISPER_MODEL_SIZE=base
ATTENTION_MODEL_CONFIDENCE_THRESHOLD=0.6

# LLM question generation (provider-agnostic — see backend/ml/llm_providers.py)
# Swapping the model or moving the provider to a hosted server requires
# ONLY editing these three values — no Python code changes.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434
# Per-request timeout (seconds) and bounded retry budget per question.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3

# LLM API (optional — for cloud-based question generation)
LLM_API_KEY=your-api-key-here
LLM_API_URL=https://api.anthropic.com/v1/messages

# Database (TinyDB for dev, replace with PostgreSQL URL for prod)
#DB_PATH=./data/neurolearn_db.json


# ============================================================
# PostgreSQL Database
# ============================================================

PG_HOST=your-postgres-host-here
PG_PORT=your-postgres-port-here
PG_DB=your-database-name-here
PG_USER=your-postgres-username-here
PG_PASSWORD=your-postgres-password-here


# ============================================================
# V2 — Local Video Storage (Phase 2)
# ============================================================
# Absolute path on the SERVER filesystem where local video files live.
# REQUIRED for real deployment — set this to wherever video files are
# actually kept on the server (a dedicated data disk/volume, a NAS mount,
# etc). Do NOT point this at a path inside this repository/checkout.
# If unset, a dev-only fallback under the current user's home directory
# is used (see backend/config/video_config.py) and a warning is logged.
VIDEO_STORAGE_DIR=/path/to/your/video/storage

# Allowed video file extensions, comma-separated (used by path validation).
ALLOWED_VIDEO_EXTENSIONS=.mp4,.webm

# ============================================================
# V2 — Nginx Local Video Delivery (Phase 3)
# ============================================================
# Port Nginx listens on for LAN video requests (see nginx/render_config.sh,
# which reads this same file so Nginx and FastAPI never drift apart on
# VIDEO_STORAGE_DIR/port).
NGINX_PORT=8080

# CORS header Nginx sends for video responses. Plain <video src=...>
# playback doesn't require this, but it's set for forward-compatibility.
# "*" is fine for a LAN-only, read-only video server.
NGINX_VIDEO_CORS_ORIGIN=*

# Public base URL clients use to reach Nginx-served video — the server's
# LAN IP (NOT localhost/127.0.0.1) + NGINX_PORT. Example for a server at
# 192.168.1.50: http://192.168.1.50:8080/media
NGINX_VIDEO_BASE_URL=http://SERVER_LAN_IP:8080/media

# ============================================================
# V2 — Admin content management (Phase 4)
# ============================================================
# Shared key required (as the X-Admin-Key header) to create/delete
# courses or attach/detach videos via /api/courses admin endpoints. There
# is no student-facing way to add content — only this key holder can.
# If unset, admin endpoints refuse all requests (fail closed).
# Generate a real value for deployment, e.g.: openssl rand -hex 32
ADMIN_API_KEY=


# JWT (for future auth)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email / SMTP (for Report Card emailing)
# For Gmail: Enable 2FA → create App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_NAME=NeuroLearn

